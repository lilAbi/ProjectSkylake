[configuration]

entry_symbol = "extension_library_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/projectskylake.windows.64.debug.dll"
windows.release.x86_64 = "res://bin/projectskylake.windows.64.release.dll"
linux.debug.x86_64 = "res://bin/libprojectskylake.linux.64.debug.so"
linux.release.x86_64 = "res://bin/libprojectskylake.linux.64.release.so"
macos.debug.arm64 = "res://bin/libprojectskylake.darwin.arm64.debug.dylib"
macos.release.arm64 = "res://bin/libprojectskylake.darwin.arm64.release.dylib"
